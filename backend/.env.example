PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/chatapp
JWT_SECRET=change_me_super_secret
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# File storage for images, files and avatars (Cloudinary). Either CLOUDINARY_URL
# or the three separate keys. Without them, uploads return 503 and avatars fall
# back to small inline images.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Password-reset email (SMTP). Without SMTP_HOST/MAIL_FROM, development returns
# the reset code in the response; production answers 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Memo Chat <no-reply@example.com>"
